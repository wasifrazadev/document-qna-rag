# Required: get a key from https://console.mistral.ai
MISTRAL_API_KEY=your-mistral-api-key

# Optional (defaults shown)
MISTRAL_MODEL=mistral-tiny

# IMPORTANT: use the same embedding model for ingestion and for the API.
# If you change it, re-run: python -m scripts.ingest --reset
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

CHROMA_DIR=chroma-db
DOCS_DIR=docs

# Retriever tuning (MMR)
RETRIEVER_K=4
RETRIEVER_FETCH_K=10
RETRIEVER_LAMBDA_MULT=0.5

# Comma-separated list of allowed frontend origins.
# "*" is fine for local development; restrict it in production.
ALLOWED_ORIGINS=*
